{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorshipFluent",
  "version": "2.0.4",
  "identifier": "com.worshipfluent.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorshipFluent",
        "label": "main",
        "width": 520,
        "height": 560,
        "minWidth": 440,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.worshipfluent.com wss://api.worshipfluent.com http: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/WorshipFluent/worshipfluent-bridge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFNTJENDI4QUZGQTRCRTcKUldUblMvcXZLTlJTM3NlK3h2Uk1LbmhwL1dPRk5BUjNOSXRjMnBCR0w3MjVROFhyRXlHS2RBckgK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "worshipfluent"
        ]
      }
    }
  }
}
